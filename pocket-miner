#!/usr/bin/env node
import { parseArgs } from 'node:util';
import { randomUUID } from 'node:crypto';
import { link, mkdir, open, unlink } from 'node:fs/promises';
import { dirname, join, resolve } from 'node:path';
import { repoFile, uploadCommand, uploadSource, verifyRemote } from './lib/hugging-face.mjs';
import { pack } from './lib/pack.mjs';
import { preparePractice } from './lib/practice/report.mjs';
import { renderReport } from './lib/report.mjs';
import { roundDigest, weeklyRound } from './lib/round.mjs';
import { canonicalSource, checkSource, readRegular, sha256 } from './lib/source.mjs';
import { postEnvelope, signedSubmission, submissionIdentity } from './lib/submission.mjs';
import { defaultPython, walletCall } from './lib/wallet.mjs';

const help = `Usage:
  pocket-miner pack [--project DIR] --base-image-digest DIGEST --out FILE
  pocket-miner check FILE
  pocket-miner digest FILE
  pocket-miner report REPORT.json --out FILE.html [--tasks SET.json]
  pocket-miner practice --harness FILE.mjs --tasks SET.json --model-url URL --model NAME[,NAME...] --out DIR
    [--key-env VAR] [--ids ID,ID] [--limit N] [--concurrency N]
  pocket-miner round --network NETWORK --netuid N --start S --length L --block B
  pocket-miner round-digest --round-zero FILE --round-id ID
  pocket-miner submission-id --netuid N --hotkey SS58 --round DIGEST --source FILE [--repo OWNER/NAME]
  pocket-miner publish IDENTITY --repo OWNER/NAME --out DIR [--upload]
  pocket-miner verify-remote IDENTITY --repo OWNER/NAME
  pocket-miner sign IDENTITY --round-id ID --hotkey-file PATH --out FILE
  pocket-miner commit IDENTITY --hotkey-file PATH --network NETWORK [--repo OWNER/NAME] --allow-writes
  pocket-miner submit IDENTITY --round-id ID --hotkey-file PATH (--out FILE | --endpoint URL)

For --tasks, use the exact task set used for that run.
For --length, use the published round length (normally 100800 blocks, about two weeks).
IDENTITY stands for --netuid N --hotkey SS58 --round DIGEST --source FILE.
Set --python PATH or POCKET_MINER_PYTHON to select the Bittensor interpreter.`;
const identityFlags = ['netuid', 'hotkey', 'round', 'source'];
const walletFlags = [...identityFlags, 'hotkey-file', 'python'];
const flags = {
  pack: ['project', 'base-image-digest', 'out'],
  round: ['network', 'netuid', 'start', 'length', 'block'],
  'round-digest': ['round-zero', 'round-id'],
  check: [],
  digest: [],
  report: ['out', 'tasks'],
  practice: ['harness', 'tasks', 'model-url', 'model', 'out', 'key-env', 'ids', 'limit', 'concurrency'],
  'submission-id': [...identityFlags, 'repo'],
  publish: [...identityFlags, 'repo', 'out', 'upload'],
  'verify-remote': [...identityFlags, 'repo'],
  sign: [...walletFlags, 'round-id', 'out'],
  commit: [...walletFlags, 'network', 'allow-writes', 'repo'],
  submit: [...walletFlags, 'round-id', 'out', 'endpoint']
};

function requireValue(values, name) {
  if (!values[name]) throw Error('Missing --' + name);
  return values[name];
}

async function save(path, bytes) {
  // Publish only a complete file, even when two CLI processes choose the same name.
  const temp = join(dirname(path), '.pocket-miner-' + randomUUID());
  const file = await open(temp, 'wx', 0o600);
  try {
    try { await file.writeFile(bytes); } finally { await file.close(); }
    await link(temp, path);
  } finally {
    await unlink(temp);
  }
}

async function readReportJson(path, label) {
  const bytes = await readRegular(path, 32 * 1024 * 1024);
  try { return JSON.parse(bytes); }
  catch { throw Error('Invalid ' + label + ' JSON'); }
}

async function main([command, ...args]) {
  if (!command || command === '--help' || command === 'help') return console.log(help);
  if (!Object.hasOwn(flags, command)) throw Error('Unknown command. See --help');
  const options = Object.fromEntries(flags[command].map(key => [key, { type: ['allow-writes', 'upload'].includes(key) ? 'boolean' : 'string' }]));
  const { values, positionals } = parseArgs({ args, options, allowPositionals: ['digest', 'check', 'report'].includes(command) });
  const need = key => requireValue(values, key);
  if (command === 'practice') {
    const out = need('out');
    const integer = key => {
      if (values[key] === undefined) return undefined;
      if (!/^\d+$/.test(need(key))) throw Error('Invalid --' + key);
      return Number(values[key]);
    };
    const run = await preparePractice({ harness: need('harness'), set: await readReportJson(need('tasks'), 'task set'),
      modelUrl: need('model-url'), models: need('model').split(','), keyEnv: values['key-env'],
      ids: values.ids?.split(','), limit: integer('limit'), concurrency: integer('concurrency') });
    await mkdir(out, { mode: 0o700 });
    console.error('The harness runs as a normal local process without the sandbox.');
    console.error('Gate scenes and the build are not checked.');
    const stop = new AbortController();
    const interrupt = () => stop.abort();
    process.on('SIGINT', interrupt);
    process.on('SIGTERM', interrupt);
    let report;
    try { report = await run(row => console.error(row.id, row.model, row.state), stop.signal); }
    finally {
      process.off('SIGINT', interrupt);
      process.off('SIGTERM', interrupt);
    }
    await save(join(out, 'report.json'), JSON.stringify(report, null, 2) + '\n');
    const passes = report.cases.filter(row => row.state === 'passed').length;
    console.log(`Practice ${report.status}. ${passes}/${report.cases.length} cases passed.`);
    process.exitCode = { passed: 0, failed: 1, error: 2 }[report.status];
    return;
  }
  if (command === 'pack') {
    const path = need('out');
    const bytes = await pack(need('base-image-digest'), values.project);
    await save(path, bytes);
    return console.log(sha256(bytes));
  }
  if (command === 'digest' || command === 'check') {
    if (positionals.length !== 1) throw Error('Provide one source file');
    const bytes = await readRegular(positionals[0]);
    return console.log(command === 'check' ? checkSource(bytes) : sha256(canonicalSource(bytes)));
  }
  if (command === 'report') {
    if (positionals.length !== 1) throw Error('Provide one report file');
    const path = need('out');
    const report = await readReportJson(positionals[0], 'report');
    const tasks = values.tasks === undefined ? undefined : await readReportJson(need('tasks'), 'task set');
    await save(path, renderReport(report, { tasks }));
    return console.log(path);
  }
  if (command === 'round') {
    const numbers = ['netuid', 'start', 'length', 'block'].map(key => {
      if (!/^\d+$/.test(need(key))) throw Error('Invalid --' + key);
      return Number(values[key]);
    });
    return console.log(JSON.stringify(weeklyRound(need('network'), ...numbers)));
  }
  if (command === 'round-digest') {
    const record = JSON.parse(await readRegular(need('round-zero'), 65536));
    return console.log(roundDigest(record, need('round-id')));
  }
  if (command === 'commit' && !values['allow-writes']) throw Error('Commit requires --allow-writes');
  if (['commit', 'sign', 'submit'].includes(command)) need('hotkey-file');
  if (command === 'publish' || command === 'verify-remote') need('repo');
  if (command === 'submit' && Boolean(values.out) === Boolean(values.endpoint)) throw Error('Choose --out or --endpoint');
  if (command === 'sign') need('out');
  if (!/^\d+$/.test(need('netuid'))) throw Error('Invalid netuid');
  const netuid = Number(values.netuid), hotkey = need('hotkey'), round = need('round');
  const source = canonicalSource(await readRegular(need('source')));
  const identity = submissionIdentity(netuid, hotkey, round, sha256(source), values.repo);
  if (command === 'submission-id') return console.log(JSON.stringify(identity));
  if (command === 'verify-remote') {
    const status = await verifyRemote({ netuid, hotkey, round, id: identity.id, repo: values.repo,
      baseImageDigest: JSON.parse(source).baseImageDigest, testBase: process.env.POCKET_MINER_HF_BASE_URL });
    process.exitCode = status === 'ok' ? 0 : 1;
    return console.log(status);
  }
  if (command === 'publish') {
    const repoPath = repoFile(identity.id);
    const path = join(need('out'), repoPath);
    await mkdir(dirname(path), { recursive: true });
    try {
      await save(path, source);
    } catch (error) {
      if (error.code !== 'EEXIST' || !(await readRegular(path)).equals(source)) throw error;
    }
    const args = ['upload', values.repo, path.startsWith('-') ? './' + path : path, repoPath];
    console.log(JSON.stringify({ ...identity, repoPath, uploadCommand: uploadCommand(args) }));
    if (values.upload) await uploadSource(args);
    return;
  }
  const python = values.python || process.env.POCKET_MINER_PYTHON || defaultPython;
  const wallet = { hotkeyFile: resolve(values['hotkey-file']), hotkey };
  if (command === 'commit') {
    const result = await walletCall(python, { ...wallet, method: 'commit', netuid, commitment: identity.commitment,
      network: need('network'), allowWrites: values['allow-writes'] });
    return console.log(JSON.stringify(result));
  }
  const bytes = await signedSubmission({ netuid, hotkey, round, roundId: need('round-id'), source },
    message => walletCall(python, { ...wallet, method: 'sign', message: message.toString('ascii') }));
  if (values.out) await save(values.out, bytes);
  else await postEnvelope(values.endpoint, bytes);
  console.log(JSON.stringify(identity));
}

main(process.argv.slice(2)).catch(error => {
  // System and argument-parser errors may echo paths or supplied option values.
  const messages = { EEXIST: 'Output file already exists', ENOENT: 'File not found', EACCES: 'Permission denied' };
  const text = error instanceof TypeError ? 'Invalid arguments or transport failure' :
    error.code ? (messages[error.code] ?? 'File or argument error') : error.message;
  console.error(process.argv[2] === 'check' ? 'Source check failed — ' + text : text);
  process.exitCode = process.argv[2] === 'practice' ? 2 : 1;
});
